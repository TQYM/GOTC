# CITY20 环境变量示例（真实密钥禁入仓库；复制为 .env 使用）
# 不配 key 也能完整打完一局：全部 AI 输出走 04 §6 模板降级。

CITY20_LLM_API_KEY=
CITY20_LLM_BASE_URL=https://api.deepseek.com/v1
CITY20_LLM_MODEL=deepseek-chat

# 三角色可分别路由不同模型（OpenAI 兼容即可：Qwen/Kimi/GLM/Ollama/vLLM）
# CITY20_LLM_MODEL_NEWS=
# CITY20_LLM_MODEL_CITIZEN=
# CITY20_LLM_MODEL_MENTOR=

# 本地兜底（Ollama）：CITY20_LLM_BASE_URL=http://localhost:11434/v1
# 超时与并发按 04 §7 默认值：news/citizen 8s、mentor/report 20s、峰值 3 并发
# CITY20_LLM_TIMEOUT_SHORT=8
# CITY20_LLM_TIMEOUT_LONG=20
# CITY20_LLM_MAX_CONCURRENT=3
